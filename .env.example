# ═══════════════════════════════════════════════════════════════
# AI Revenue Recovery Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────
# Options: groq (recommended for deployment), ollama (local)
LLM_PROVIDER=groq

# Groq (hosted, fast — get key at https://groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, free — runs on your machine)
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# ── Razorpay (Test Mode) ──────────────────────────────────────
# Get test keys from https://dashboard.razorpay.com → Test Mode
# Leave empty to skip real payment links (simulation only)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# ── SendGrid (Real Emails) ────────────────────────────────────
# Get API key from https://app.sendgrid.com → Settings → API Keys
# Leave empty to skip real emails (simulation only)
# Important: Verify sender email in SendGrid dashboard first!
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER=noreply@your-verified-domain.com

# ── Deployment / App URLs ─────────────────────────────────────
# Base URL of your deployed app (used for on-demand payment links in emails)
# Local dev: http://localhost:8000
# Render:    https://your-app.onrender.com
BASE_URL=http://localhost:8000

# CORS origin for frontend (local dev only)
FRONTEND_ORIGIN=http://localhost:5173
